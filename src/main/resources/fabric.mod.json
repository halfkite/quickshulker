{
  "schemaVersion": 1,
  "id": "quickshulker",
  "version": "${version}",
  "name": "QuickShulkerMore",
  "description": "Quickly open Shulker boxes and more",
  "authors": [
    "kyrptonaught",
    "MoRanpcy",
    "Hao_cen",
    "Grayer0113"
  ],
  "contact": {
    "homepage": "https://github.com/halfkite/quickshulkermore",
    "sources": "https://github.com/halfkite/quickshulkermore",
    "issues": "https://github.com/halfkite/quickshulkermore/issues"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.homepage": "https://github.com/halfkite/quickshulkermore",
        "modmenu.sources": "https://github.com/halfkite/quickshulkermore"
      }
    }
  },
  "license": "MIT",
  "icon": "assets/quickshulker/icon.png",
  "environment": "*",
  "mixins": [
    {
      "config": "quickshulker.mixins.json",
      "environment": "*"
    },
    {
      "config": "quickshulker-compat.mixins.json",
      "environment": "*"
    },
    {
      "config": "shulkerutils.mixins.json",
      "environment": "client"
    },
    {
      "config": "kyrptconfig.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "net.kyrptonaught.quickshulker.QuickShulkerMod"
    ],
    "quickshulker": [
      "net.kyrptonaught.quickshulker.QuickShulkerMod"
    ],
    "client": [
      "net.kyrptonaught.quickshulker.client.QuickShulkerModClient"
    ],
    "modmenu": [
      "net.kyrptonaught.quickshulker.compat.modmenu.ModMenuIntegration"
    ]
  },
  "depends": {
    "minecraft": "1.21.1",
    "fabricloader": ">=0.12.5",
    "fabric-api": "*",
    "java": ">=21"
  },
  "accessWidener": "quickshulker.accesswidener"
}
